# Cloudflare reads this file and does not serve it.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Images are not fingerprinted, so keep the cache short enough that a replaced photo shows up the same day.
/assets/*
  Cache-Control: public, max-age=3600

# The *.workers.dev address is for testing only. Keep it out of search results.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
